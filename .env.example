# OPENROUTER_API_KEY: Required for AI calls via OpenRouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL: Model to use (default: openrouter/auto).
OPENROUTER_MODEL="openrouter/auto"

# APP_URL: The URL where the app is hosted.
# Used as the HTTP-Referer header for OpenRouter.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION: Connects the app to your Supabase PostgreSQL backend.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# RATE LIMITING: Maximum AI requests per minute per IP
AI_RATE_LIMIT_PER_MINUTE=30

# VITE_API_URL: Base URL for backend server (required for mobile Capacitor builds)
# Leave blank for local web SPA dev (defaults to relative /api routing)
VITE_API_URL=""

# SENTRY: Error tracking DSNs from https://sentry.io
# VITE_SENTRY_DSN is exposed to the browser; SENTRY_DSN is server-only.
VITE_SENTRY_DSN=""
SENTRY_DSN=""



# --- Brevo SMTP configuration (used for welcome email & optional Supabase custom SMTP) ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=b7e921001@smtp-brevo.com
BREVO_SMTP_PASSWORD=YOUR_BREVO_PASSWORD_HERE
