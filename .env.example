# OPENROUTER_API_KEY: Required for AI calls via OpenRouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL: Model to use (default: openrouter/auto).
OPENROUTER_MODEL="openrouter/auto"

# APP_URL: The URL where the app is hosted.
# Used as the HTTP-Referer header for OpenRouter.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION: Connects the app to your Supabase PostgreSQL backend.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# RATE LIMITING: Maximum AI requests per minute per IP
AI_RATE_LIMIT_PER_MINUTE=30
